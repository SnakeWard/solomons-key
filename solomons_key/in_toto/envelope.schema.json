{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/attestation/v1/envelope.schema.json",
  "title": "Unsigned DSSE envelope for a Solomon's Key in-toto statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payloadType", "signatures"],
  "properties": {
    "payload": {
      "type": "string",
      "minLength": 1,
      "description": "Standard base64 of the canonical Statement JSON"
    },
    "payloadType": {
      "const": "application/vnd.in-toto+json"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": { "type": "string" },
          "sig": { "type": "string" }
        }
      }
    }
  }
}
