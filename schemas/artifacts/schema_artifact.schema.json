{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/schema_artifact.schema.json",
  "title": "Schema Artifact",
  "description": "Proof of schema validation against governed partial schema.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "schema_artifact"
    },
    "required_gate": {
      "const": "schema_validation_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of schema validation against a governed partial schema",
      "required": [
        "schema_id",
        "schema_sha256",
        "instance_sha256",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
