{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/task_frame_artifact.schema.json",
  "title": "Task Frame Artifact",
  "description": "Proof of bounded Task Frame receipt and validation.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "task_frame_artifact"
    },
    "required_gate": {
      "const": "task_frame_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of bounded Task Frame receipt",
      "required": [
        "task_frame_id",
        "task_type",
        "task_scope",
        "requested_by"
      ],
      "additionalProperties": false,
      "properties": {
        "task_frame_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "task_scope": {
          "type": "string",
          "minLength": 1
        },
        "requested_by": {
          "enum": [
            "Codex",
            "Grok",
            "Claude",
            "user"
          ]
        },
        "declared_forbidden_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "task_frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
