{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/gate_decision_artifact.schema.json",
  "title": "Gate Decision Artifact",
  "description": "Proof of gate decision for each evaluated gate.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "gate_decision_artifact"
    },
    "required_gate": {
      "const": "artifact_requirement_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of gate decision for each evaluated gate",
      "required": [
        "gate_id",
        "decision",
        "enforcement_class",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "decision": {
          "enum": [
            "pass",
            "fail",
            "refuse",
            "refused",
            "repair_required",
            "blocked",
            "escalated"
          ]
        },
        "enforcement_class": {
          "enum": [
            "automatic",
            "attested",
            "composite",
            "unimplemented"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_.-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 1,
          "description": "A gate decision with no evidence is an assertion, not a decision."
        },
        "failure_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation": {
          "description": "Required when enforcement_class is 'attested'.",
          "type": "object",
          "required": [
            "attested_by",
            "statement"
          ],
          "additionalProperties": false,
          "properties": {
            "attested_by": {
              "enum": [
                "Codex",
                "Grok",
                "Claude",
                "user"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
