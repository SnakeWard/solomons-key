{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/task_frame_validation_artifact.schema.json",
  "title": "Task Frame Validation Artifact",
  "description": "Proof of Task Frame gate pass.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "task_frame_validation_artifact"
    },
    "required_gate": {
      "const": "task_frame_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of Task Frame gate pass",
      "required": [
        "task_frame_id",
        "decision",
        "forbidden_type_matched"
      ],
      "additionalProperties": false,
      "properties": {
        "task_frame_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "decision": {
          "enum": [
            "pass",
            "fail",
            "refuse",
            "refused",
            "repair_required",
            "blocked",
            "escalated"
          ]
        },
        "forbidden_type_matched": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal_condition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
