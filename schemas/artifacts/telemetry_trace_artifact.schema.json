{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/telemetry_trace_artifact.schema.json",
  "title": "Telemetry Trace Artifact",
  "description": "Proof of ordered telemetry trace for a governed route.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "telemetry_trace_artifact"
    },
    "required_gate": {
      "const": "telemetry_requirement_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of ordered telemetry trace for a governed route",
      "required": [
        "route_id",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_type",
              "event_sequence_index"
            ],
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "event_type": {
                "type": "string",
                "minLength": 1
              },
              "event_sequence_index": {
                "type": "integer",
                "minimum": 0
              },
              "event_purpose": {
                "type": "string"
              },
              "ledger_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "Sequence indices must be contiguous from 0. Checked by sk_artifacts, not by JSON Schema."
        },
        "sequence_policy": {
          "const": "ordered_append_only"
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
