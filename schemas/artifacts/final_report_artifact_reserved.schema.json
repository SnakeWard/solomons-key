{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/final_report_artifact_reserved.schema.json",
  "title": "Final Report Artifact Reserved",
  "description": "Reserved artifact reference for runtime final assembly report.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "final_report_artifact_reserved"
    },
    "required_gate": {
      "const": "final_assembly_gate"
    },
    "body": {
      "type": "object",
      "title": "Reserved artifact reference for runtime final assembly report",
      "required": [
        "reserved",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "reserved": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requires_user_authorization": {
          "const": true
        }
      }
    },
    "artifact_status": {
      "const": "reserved"
    }
  },
  "required": [
    "artifact_id"
  ]
}
