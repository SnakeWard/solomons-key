{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/audit_report_artifact.schema.json",
  "title": "Audit Report Artifact",
  "description": "Proof of audit, refusal, or escalation action.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "audit_report_artifact"
    },
    "required_gate": {
      "const": "actor_authority_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of audit, refusal, or escalation action",
      "required": [
        "action",
        "reason",
        "failure_id"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "audit",
            "refusal",
            "escalation"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "failure_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "severity": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            "terminal"
          ]
        },
        "escalated_to": {
          "enum": [
            "user",
            "none"
          ]
        },
        "resolved_by_ai_actor": {
          "const": false,
          "description": "No AI actor may resolve an escalation without user direction."
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
