{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/lot_route_artifact.schema.json",
  "title": "L.O.T. Route Artifact",
  "description": "Proof of selected L.O.T. route.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "lot_route_artifact"
    },
    "required_gate": {
      "const": "lot_route_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of selected L.O.T. route",
      "required": [
        "selected_route_id",
        "eligible_route_ids",
        "selection_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "selected_route_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "eligible_route_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "minItems": 1
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "fallback_route_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
