{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomons-key.dev/schemas/artifacts/v1/validation_report_artifact.schema.json",
  "title": "Validation Report Artifact",
  "description": "Proof of validation script pass for each governed pass.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "artifact_id": {
      "const": "validation_report_artifact"
    },
    "required_gate": {
      "const": "artifact_requirement_gate"
    },
    "body": {
      "type": "object",
      "title": "Proof of validation script pass for a governed pass",
      "required": [
        "layers_run",
        "layers_skipped",
        "result",
        "validator_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "layers_run": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "layers_skipped": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Validation bypass is rejected. A non-empty list must be justified."
        },
        "skip_justification": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "repair_required",
            "refused",
            "escalated",
            "blocked",
            "not_checked"
          ]
        },
        "validator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "severity",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "low",
                  "moderate",
                  "high",
                  "critical",
                  "terminal"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "artifact_id"
  ]
}
